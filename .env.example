# Copy to .env (git-ignored). The CLI loads it automatically (--env-file).
# Real environment variables always win over .env values.
# Keep comments on their own lines (Docker --env-file does not strip inline ones).

# My Domain URL (no trailing slash).
SF_LOGIN_URL=https://YOURDOMAIN.develop.my.salesforce.com
# External Client App Consumer Key (identifier, not a secret, but keep it out of code).
SF_CLIENT_ID=
# --- Key-based auth (JWT Bearer): RECOMMENDED, no client secret needed ---
# Salesforce user the integration acts as (must be pre-authorized on the app).
SF_USERNAME=
# Local dev: path to the PEM private key. CI/containers: SF_PRIVATE_KEY holds the PEM (use \n for newlines).
SF_PRIVATE_KEY_PATH=./secrets/server.key
# SF_PRIVATE_KEY=
# SF_PRIVATE_KEY_PASSPHRASE=
# login.salesforce.com for Developer/production orgs; https://test.salesforce.com for sandboxes.
SF_JWT_AUDIENCE=https://login.salesforce.com
# --- Alternative: client credentials (secret-based). Ignored when the JWT settings above are set ---
# SF_CLIENT_SECRET=
SF_API_VERSION=62.0

# Optional: enables the LLM planner (falls back to rules on any failure).
ANTHROPIC_API_KEY=
BRIDGE_LLM_MODEL=claude-sonnet-5-5
# Format: key=name:ROLE,... ; roles: VIEWER, AGENT, APPROVER, ADMIN. Generate keys: openssl rand -hex 24
BRIDGE_API_KEYS=agent-key-CHANGE-ME=agent-svc:AGENT,approver-key-CHANGE-ME=jane:APPROVER
BRIDGE_FINANCIAL_THRESHOLD_USD=10000
